# ---------------------------------------------------------------------------
# .env.example - Template for backend configuration.
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# Every setting the application reads comes from this file via
# core/config.py (pydantic-settings) - no os.getenv() calls elsewhere.
# ---------------------------------------------------------------------------

# ---- App metadata ----
APP_NAME="RBL Bank Digital Office Backend"
APP_ENV="development"
APP_HOST="0.0.0.0"
APP_PORT=8516

# ---- Microsoft Graph API / Azure AD App Registration ----
TENANT_ID=""
CLIENT_ID=""
CLIENT_SECRET=""

# Public-facing base URL of this app (used to build the OAuth redirect URI).
APP_BASE_URL="http://localhost:8516"

# Shared mailbox settings (used when reading a shared mailbox instead of /me).
MAILBOX_EMAIL=""
MAILBOX_TYPE="shared"

# ---- Email cluster synthesis pipeline ----
# Master switch for the email clustering pipeline (fetch -> relevance
# filter -> embed -> cluster -> LLM synthesis -> email_clusters table).
# The pipeline runs via the external runner `python run_pipeline.py`, NOT
# inside the backend. Set false to disable all pipeline runs + LLM calls.
BU_EMAIL_PIPELINE_ENABLED=true
# Folder (relative to backend/) for the email agent's local data files
# (JSONL test logs, local-mode calendar JSON, tracker JSON fallbacks).
BU_EMAIL_DATA_DIR="data"
# Graph fetch window before the relevance filter.
EMAIL_PIPELINE_FETCH_TOP=100
# After scoring, keep only the top K candidates for embedding/clustering.
EMAIL_PIPELINE_CANDIDATE_POOL_SIZE=20
# Server-side Graph filter: only fetch mail received within this many days
# before the pipeline run. 0 falls back to MEETING_HISTORY_LOOKBACK_DAYS.
EMAIL_PIPELINE_FETCH_RECEIVED_AFTER_DAYS=0
# Relevance junk gate. The cutoff is derived per-run from the batch's own score
# distribution (Otsu natural break). EMAIL_RELEVANCE_MIN_SCORE is only an
# optional HARD FLOOR (0 = none). Strictness 0 = pure Otsu break; raise toward
# 1 to keep only the stronger tail.
EMAIL_RELEVANCE_ADAPTIVE_CUTOFF_ENABLED=true
EMAIL_RELEVANCE_MIN_SCORE=0
EMAIL_RELEVANCE_ADAPTIVE_STRICTNESS=0.0
# Relevance filter weights (token overlap vs semantic vs BU_DEPARTMENTS).
EMAIL_RELEVANCE_TOKEN_WEIGHT=0.5
EMAIL_RELEVANCE_SEMANTIC_WEIGHT=0.5
# Meeting-aware relevance: weight for how similar an email is to the
# current/upcoming calendar meeting(s). Blended with token+semantic and
# renormalized so all three sum to 1. 0 = disabled. Requires
# MEETING_ANCHORED_CLUSTERING_ENABLED.
EMAIL_RELEVANCE_MEETING_WEIGHT=0.0
# Only occurrences within +/- this many days of the run count as "current"
# for meeting-aware relevance. 0 = any loaded occurrence contributes.
EMAIL_RELEVANCE_MEETING_WINDOW_DAYS=7
# Clustering algorithm: "components" (cosine graph + connected components),
# "knn" (1-NN union-find), or "agglomerative" (complete-linkage). Switch here.
EMAIL_CLUSTER_ALGO="components"
# Cosine threshold for BOTH algos: graph-edge floor (components) or
# 1-NN join floor (knn). Tune from [CLUSTER-EDGE]/[CLUSTER-NN] logs.
EMAIL_CLUSTER_SIMILARITY_THRESHOLD=0.72
# Recurring-series near-miss: join emails just below the cosine floor
# when their subject stems still match (months/MoM stripped, WB expanded).
EMAIL_CLUSTER_SERIES_NEAR_MISS=0.68
EMAIL_CLUSTER_SERIES_JACCARD=0.5
EMAIL_CLUSTER_RESIDUAL_THRESHOLD=0.68
# Min cosine similarity required when merge_quoted_subject_links joins two
# emails via a quoted Subject: header match. Prevents a forwarded compilation
# email from acting as a hub-and-spoke connector between unrelated topics
# purely through quoted headers, with no semantic similarity required.
# 0.0 = disabled (pure string-match, old behaviour).
EMAIL_CLUSTER_CITE_MIN_COSINE=0.50
# Embedding text for clustering (subject repeated for topic weight).
EMAIL_EMBED_BODY_MAX_CHARS=8000
EMAIL_EMBED_ATTACHMENT_MAX_CHARS=8000
EMAIL_EMBED_SUBJECT_COPIES=2
# Semantic (business-context) clustering embedding. When true, the embedding
# is built from the LLM-extracted business objective + topic + subtopics +
# entities + actions/decisions instead of raw subject/body, so emails that
# share only a broad topic but drive DIFFERENT objectives do not cluster
# together. Falls back to raw text per email when semantics are empty.
EMAIL_EMBED_SEMANTIC_ENABLED=true
# Times the business objective (the discriminator) is repeated so it
# dominates the centroid. 1 = no extra weight.
EMAIL_EMBED_OBJECTIVE_WEIGHT=2
# Chars of raw body appended as grounding context after the structured
# semantic lines. 0 = pure-semantic (omit the raw body slice).
EMAIL_EMBED_SEMANTIC_BODY_CONTEXT_CHARS=600
# Per-email structured semantics are extracted ONCE at the relevance stage
# and reused by clustering (no separate topic-tag LLM call to configure).
# Cluster synthesis LLM prompt. 0 = unlimited (full body + full MoM).
EMAIL_SYNTH_BODY_MAX_CHARS=0
EMAIL_SYNTH_ATTACHMENT_MAX_CHARS=0
# Max emails per LLM synthesis batch within one cluster.
EMAIL_CLUSTER_MAX_SIZE=10
# If the top two department prototype scores (0-100) differ by this
# much or less, break the tie with token overlap vs each department's
# own dictionary. 0 = never. Not a per-subject rule.
EMAIL_DEPT_ASSIGNMENT_MARGIN=3.0
# Min department prototype score (0-100) to assign a department label.
# Below this a cluster is left unlabeled rather than force-assigned to the
# nearest department. Raised from 40 to reduce governance/general-topic
# emails (e.g. Steering Committee) from being mis-tagged Wholesale Banking.
EMAIL_DEPT_ASSIGNMENT_MIN_SCORE=52
# Real-time meeting -> precomputed cluster match (0-100 cosine scale).
MEETING_CLUSTER_MATCH_THRESHOLD=62
# After occurrence-split, include sibling occurrence rows of a selected series
# by recurring-series stem even when they sit below the meeting-cosine floor.
MEETING_CLUSTER_SERIES_RETRIEVE_ENABLED=true

# ---- Meeting-anchored per-occurrence clustering ----
# Master switch. When true, the pipeline anchors each email to a specific
# PAST meeting occurrence (from calendar history) and clusters WITHIN an
# occurrence, so a recurring series (April MBR / May MBR / June MBR) yields
# one line item per meeting instead of a single merged blob. false = the
# old pure-semantic + series-merge behaviour.
MEETING_ANCHORED_CLUSTERING_ENABLED=true
# Days of calendar history pulled ONCE (independent of the ~5-min today
# poll) to enumerate past occurrences. ~2 months by default.
MEETING_HISTORY_LOOKBACK_DAYS=60
# Max occurrences fetched in the one-time historical calendarView call.
MEETING_HISTORY_FETCH_TOP=250
# Re-pull the history window at most this often (hours). 0 = pull once per
# process and never again until restart.
MEETING_HISTORY_REFRESH_HOURS=24
# Min cosine (0-1) between an email and an occurrence embedding to anchor.
# Raised from 0.70 → 0.72 to prevent cross-domain anchoring (Digital Steerco
# emails were anchoring to Wholesale MBR at cosine ~0.56).
MEETING_ANCHOR_SEMANTIC_THRESHOLD=0.72
# Treat a MoM email as a strong "meeting already concluded" signal: relax
# the semantic gate to MEETING_ANCHOR_MOM_SEMANTIC_THRESHOLD so the MoM and
# its thread reliably pin to the nearest preceding occurrence.
MEETING_ANCHOR_MOM_IS_STRONG=true
# Raised from 0.50 → 0.68: MoM emails were anchoring at cosines as low as
# 0.52 (ISSC minutes → WB MBR). 0.68 still catches legitimate WB MoMs
# (July WBR minutes cosine=0.673) while blocking cross-domain matches.
MEETING_ANCHOR_MOM_SEMANTIC_THRESHOLD=0.68
# Detect MoM from the email subject/body too (not just attachment name).
# Only strengthens anchoring; clustering embeddings are unaffected.
MEETING_ANCHOR_MOM_BODY_DETECTION_ENABLED=true
# Comma-separated MoM phrases (multi-word = substring; single token = word
# boundary). Case-insensitive.
MEETING_ANCHOR_MOM_BODY_KEYWORDS="minutes of meeting,minutes of the meeting,meeting minutes,mom,action points from,actions from,notes from the meeting"
# Optional cap on how long after a meeting ends an email may still anchor to it.
# 0 = no cap (only bounded by the current pipeline run).
MEETING_ANCHOR_MAX_POST_MEETING_DAYS=0.0
# Fallback subject tokens used to detect a post-meeting anchor when no calendar
# occurrence matches (comma-separated).
EMAIL_CLUSTER_ANCHOR_TOKENS="minutes,mom,notes,note,action,actions"

# ---- Meeting-level related-cluster relevance (ONE-OFF vs RECURRING) ----
# Which historical clusters are "relevant" to a live meeting is decided by an
# ADAPTIVE cutoff computed from the actual candidate-score distribution (Otsu
# natural break) that separates the highly-matched clusters from the broader,
# lower-matched ones. This dial does NOT replace that adaptive method; it only
# shifts the resulting break up or down (in 0-100 cosine points) for tuning.
#   Increase (> 0) -> higher effective cutoff -> fewer, more closely matched clusters
#   Decrease (< 0) -> lower  effective cutoff -> more clusters allowed through
# Start at 0 (pure adaptive break) and tune from real meeting results rather
# than hard-coding a new fixed threshold. The effective cutoff is still clamped
# to MEETING_RELATED_CANDIDATE_MIN_SCORE.
MEETING_RELATED_ADAPTIVE_CUTOFF_ADJUSTMENT=0
# Stage-1 semantic candidate floor (0-100) and max candidate count for the
# related-cluster retrieval.
MEETING_RELATED_CANDIDATE_MIN_SCORE=45.0
MEETING_RELATED_CANDIDATE_MAX=12
# Recurrence evidence thresholds: a meeting is RECURRING only with at least
# this many relevant historical clusters spanning this many distinct periods.
MEETING_RECURRENCE_MIN_OCCURRENCES=2
MEETING_RECURRENCE_MIN_DISTINCT_PERIODS=2

# Stage-2 business-context relevance gate (strict LLM classifier) that judges
# each stage-1 semantic candidate cluster against the live meeting. This is an
# expensive per-meeting Ollama call. Set to false to DISABLE the LLM gate and
# keep the stage-1 adaptive-cutoff semantic candidates as the relevant set
# (no LLM call). The gate code stays intact, so flipping this back to true is a
# zero-code rollback.
MEETING_RELATED_RELEVANCE_GATE_ENABLED=true

# Explicit calls to the authenticated summarizer-test endpoint append one
# JSON object per tested email here. This does not affect bu_emails.csv.
EMAIL_SUMMARIZER_TEST_LOG_ENABLED=true
EMAIL_SUMMARIZER_TEST_LOG_FILENAME="email_summarizer_test_logs.jsonl"

# Graph auth mode:
#   "delegated" - /login + /callback browser OAuth against Microsoft.
#   "app_only"  - client-credentials against the shared mailbox.
#   "local"     - no Microsoft auth; mail is read from EML_STORAGE_DIR
#                 (.eml files, e.g. backend/temp_mail_data) and calendar
#                 events from LOCAL_CALENDAR_PATH. Use this for localhost
#                 development without Graph API.
# Default is "delegated" so email + calendar come live from Graph API and
# SSO is enforced. Switch to "local" only for offline development.
GRAPH_AUTH_MODE="delegated"
GRAPH_REQUEST_TIMEOUT_SECONDS=30
# Folder (relative to backend/) of Outlook .eml exports used in local mode
# and by the chatbot / eml summariser.
EML_STORAGE_DIR="temp_mail_data"
# Dummy Outlook calendar JSON used only when GRAPH_AUTH_MODE=local.
LOCAL_CALENDAR_PATH="data/local_calendar.json"

# ---- Attachment MoM (Minutes of Meeting) fuzzy filter ----
# When true, only attachments whose filename fuzzy-matches one of the
# keywords below are parsed at all - everything else is skipped before any
# extraction happens, so unrelated attachments never bloat the LLM prompt.
MOM_ATTACHMENT_FILTER_ENABLED=true
# Comma-separated keywords/phrases an attachment filename must fuzzily
# match at least one of (case-insensitive, substring-style match).
MOM_ATTACHMENT_KEYWORDS="Minutes of Meeting,MoM,Minutes,Meeting Notes,Meeting Minutes"
# Minimum fuzzy match score (0-100) required against any one keyword.
MOM_ATTACHMENT_FUZZY_THRESHOLD=80

# ---- BU departments (relevance filter + cluster synthesis) ----
# JSON array of {"name","view","summary"} objects. Used by the relevance
# filter, cluster synthesis LLM, and meeting->cluster embedding match.
BU_DEPARTMENTS='[{"name":"BB&RL","view":"Retail","summary":"Retail branch banking and retail liabilities only: branch network, retail CASA, retail CA/SA targets, retail term deposits, branch deposit mobilisation and branch operations. Not wholesale CA/SA, not the wholesale or corporate book."},{"name":"Credit Cards","view":"CRO","summary":"Credit cards business only: card acquisition and activation, spends and interchange, cards portfolio, EMI, rewards, delinquency and collections specific to cards. Not corporate credit TAT or wholesale underwriting."},{"name":"Retail Advances - Excluding Credit Cards","view":"RetailAssets","summary":"Retail lending other than credit cards: home loans, LAP, personal loans, secured and unsecured retail assets, disbursements, retail GNPA and collections excluding cards."},{"name":"Wholesale Banking","view":"Wholesale","summary":"Wholesale and corporate banking: large/mid corporate relationships, wholesale deposits, wholesale CASA, wholesale CA/SA targets, WB CA/SA, transaction banking, trade and treasury client coverage, NIM pack and funding-cost assumptions on the wholesale book, corporate credit TAT, underwriting, pipeline and sanctions."}]'
# Embedding model (must be pulled on the Ollama host).
EMBEDDING_MODEL="nomic-embed-text"
# Vector width the embedding model produces. Stored with every embedding
# (never hardcoded in source) so a model/dim change is detectable. 768 for
# nomic-embed-text.
EMBEDDING_DIM=768

# ---- Vector-store backend toggle (email agent only, TEMPORARY) ----
# Selects which vector store the EMAIL CLUSTER pipeline (agent_email) uses
# for its cluster/meeting embeddings. Does NOT affect the chatbot (always
# Weaviate).
#   "weaviate" (default) = the bank's shared Weaviate deployment (needs the
#                          WEAVIATE_* endpoints below reachable).
#   "faiss"              = a local on-disk FAISS index under FAISS_INDEX_DIR,
#                          so the pipeline can run with no Weaviate server.
# This is a temporary switch meant to be removed later (delete core/faiss/,
# agent_email/vector_store_backend.py, and set this back to weaviate).
VECTOR_STORE_BACKEND="weaviate"
# Where the local FAISS index files + id maps live (one per namespace),
# relative to backend/ unless absolute. Only used when
# VECTOR_STORE_BACKEND="faiss".
FAISS_INDEX_DIR="core/faiss/index_data"
# Extra phrases per department for relevance-filter semantic centroids.
# Shared products (CASA / CA/SA / deposits) are qualified retail vs wholesale.
DEPARTMENT_TAGGING_EXAMPLE_PHRASES='{"BB&RL":["retail CASA deposits","branch banking","branch term deposit mobilisation","retail savings and current account growth","virtual RM VRM","retail liability book","retail CA/SA targets","retail term deposits","retail deposit base","branch CASA mobilisation","branch deposit growth"],"Credit Cards":["credit card spends","card acquisition and activation","interchange income","card EMI","card rewards","cards delinquency and collections"],"Retail Advances - Excluding Credit Cards":["home loan disbursement","loan against property LAP","personal loan","microfinance JLG MFI collections","retail GNPA","secured and unsecured retail assets"],"Wholesale Banking":["corporate advances","WB wholesale banking","large and mid corporate relationships","transaction banking","trade finance","treasury client coverage","wholesale deposits","wholesale CASA","wholesale CA/SA targets","WB CA/SA targets","WB CASA targets","wholesale current and savings accounts","FIGU and corporate CASA","cost of funds on the WB book","NIM pack funding cost assumption","wholesale deposit mix","corporate credit turnaround time TAT","corporate credit underwriting","corporate proposal exception cases","corporate credit pipeline and sanctions"]}'

# ---- Frontend / server-side session (delegated SSO flow) ----
# URL the browser is redirected to after a successful /auth/callback.
FRONTEND_URL="http://localhost:8518"
# HTTP-only cookie that carries the opaque session id (Graph tokens stay
# server-side and are never exposed to the browser).
SESSION_COOKIE_NAME="rbl_session"
# Same-origin deployment (FRONTEND_URL and APP_BASE_URL share a host, e.g.
# both behind the same nginx/LB domain): keep SAMESITE=lax. Only switch to
# SAMESITE=none (with SECURE=true, required by browsers for None) if the
# SPA truly runs on a different origin/port than this backend. For local
# http development, keep SECURE=false and SAMESITE=lax.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE="lax"
# Session lifetime in seconds; keep <= the Graph access-token lifetime.
SESSION_TTL_SECONDS=3600

# ---- AWS Secrets Manager (PostgreSQL credentials + Graph refresh token) ----
# POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB and the delegated Graph
# OAuth refresh_token are read from ONE JSON secret in AWS Secrets Manager,
# NOT from this file or the database. boto3 uses the EC2 instance IAM role
# (standard credential chain) - do NOT put AWS keys here.
AWS_REGION="ap-south-1"
AWS_SECRET_NAME="rbl-digitalofficeofceo-prod-parameterstore"

# ---- Storage backend toggle ----
# "memory" = in-process dict-based store (default, no external DB needed).
# "postgres" = tracker stores (agent_open_tracker) use PostgreSQL when set.
STORAGE_BACKEND="memory"
# PostgreSQL CONNECTION TARGET only. The username/password/database name are
# sourced from AWS Secrets Manager (see above) and spliced in at startup to
# build the DSN. Set POSTGRES_HOST to enable Postgres; leave it empty to run
# in JSON-file fallback mode. POSTGRES_OPTIONS is an optional DSN query
# string (e.g. "sslmode=require"). Credentials must NOT be placed here.
POSTGRES_HOST=""
POSTGRES_PORT=5432
POSTGRES_OPTIONS=""

# ---- Email agent storage (three-layer: PostgreSQL + Weaviate + Redis) ----
# The email cluster pipeline persists ROW data + embeddings to PostgreSQL
# (system of record), mirrors the vectors into Weaviate (rebuildable copy),
# and caches reads in Redis. There is no CSV backend. The stack activates
# automatically when POSTGRES_HOST (above) is set.

# ---- Weaviate (email agent embedding vector store) ----
# Active when POSTGRES_DSN is set. Entirely separate from the chatbot,
# which keeps its own local FAISS index untouched by this config.
# Connection uses weaviate.connect_to_custom() with independent REST and
# gRPC endpoints (bank's internal Weaviate deployment).
WEAVIATE_HTTP_HOST="weaviateui.rbl.bank.in"
WEAVIATE_HTTP_PORT=443
WEAVIATE_HTTP_SECURE=true
WEAVIATE_GRPC_HOST="rbl-common-applications-prod-nlb-c520789d68a02bed.elb.ap-south-1.amazonaws.com"
WEAVIATE_GRPC_PORT=60062
WEAVIATE_GRPC_SECURE=false
# Leave empty for anonymous access (matches the connectivity test script).
WEAVIATE_API_KEY=""
# Prefix for the two per-namespace collections (clusters/meetings), e.g.
# "EmailAgentClusters" / "EmailAgentMeetings".
WEAVIATE_EMAIL_COLLECTION_PREFIX="EmailAgent"

# ---- Redis (disposable read cache) ----
# Redis is a DISPOSABLE read cache only: nothing is lost if it is flushed,
# because every key is refilled from Weaviate/PostgreSQL at startup and
# updated after every write. Keys have NO TTL. Leave REDIS_HOST empty to
# disable the cache (reads then go straight to Weaviate/PostgreSQL).
# Connectivity test for this deployment:
#   redis-cli -h <REDIS_HOST> -p <REDIS_PORT> SET connectivity_test "hello-redis"
#   redis-cli -h <REDIS_HOST> -p <REDIS_PORT> GET connectivity_test
REDIS_HOST="rbl-common-applications-prod-nlb-c520789d68a02bed.elb.ap-south-1.amazonaws.com"
REDIS_PORT=7480
REDIS_DB=0
REDIS_PASSWORD=""
REDIS_SSL=false
# Namespace for every key this app writes (shared Redis is possible).
REDIS_KEY_PREFIX="rbl_email:"

# ---- Ollama (local open-source models) ----
OLLAMA_HOST="http://10.240.87.68:11434"
# Single model used for both OCR (vision) and text generation for now.
OLLAMA_VISION_MODEL="llama3.2-vision:11b"
# Reserved for future split (text-only tasks); falls back to the vision
# model above when unset.
OLLAMA_TEXT_MODEL=""
OLLAMA_REQUEST_TIMEOUT_SECONDS=600
OLLAMA_TEMPERATURE=0.2
# Tokens of context for chat + embeddings. 16k holds a full cluster
# (bodies + MoM attachments) in one synthesis call without the 32k KV
# cache penalty. Ollama defaults to 2048 and silently drops earlier
# emails if this is too small.
OLLAMA_NUM_CTX=16384
# Max tokens the chat model may emit. Caps cluster synthesis so a small
# local model cannot ramble instead of closing JSON. 0 = unlimited.
OLLAMA_NUM_PREDICT=768
# Higher cap for cluster synthesis so every MoM action item can be listed.
OLLAMA_CLUSTER_SYNTH_NUM_PREDICT=2048
# While a single Ollama call runs, a WARNING "still running after Ns"
# heartbeat is logged every OLLAMA_HEARTBEAT_INTERVAL_SECONDS so a long
# call is visibly progressing (not stuck). This is NOT a poll of the
# Ollama server. Set OLLAMA_HEARTBEAT_ENABLED=false to await calls
# quietly with no heartbeat log lines.
OLLAMA_HEARTBEAT_ENABLED=true
OLLAMA_HEARTBEAT_INTERVAL_SECONDS=15

# ---- Concurrency limits (in-process asyncio.Semaphore worker pools) ----
MAX_CONCURRENT_GRAPH_CALLS=5
MAX_CONCURRENT_OLLAMA_CALLS=2
# Separate, usually-stricter cap on concurrent BU pipeline messages, since
# Graph enforces its own per-mailbox concurrency limit on the shared
# mailbox independent of MAX_CONCURRENT_GRAPH_CALLS above.
BU_PIPELINE_MAX_CONCURRENT_MESSAGES=3
# Number of queue-based worker coroutines that synthesize email clusters in
# parallel during a pipeline run. Controls how many CLUSTERS are summarized
# at once; does NOT affect clustering/anchoring. Simultaneous Ollama calls
# are still capped by MAX_CONCURRENT_OLLAMA_CALLS above (more workers just
# keep that semaphore busy). 1 = old sequential behaviour.
EMAIL_PIPELINE_CLUSTER_WORKERS=2

# Number of EMAILS processed concurrently through the relevance / single
# structured-extraction stage (context extraction + meeting-match + gate
# embedding). Only governs how many emails are in flight; simultaneous Ollama
# calls are still capped by MAX_CONCURRENT_OLLAMA_CALLS. 1 = fully sequential
# (safe default for a single local Ollama host).
EMAIL_PIPELINE_RELEVANCE_WORKERS=1

# ---- Retry / backoff ----
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=1.0

# ---- Calendar polling ----
# Master switch for the frontend's real-time calendar polling. The
# calendar agent has no server-side loop; when false, the SPA (which
# reads GET /agents/calendar/polling-config) should stop its timer and
# only fetch calendar data on demand.
CALENDAR_POLLING_ENABLED=true
# Interval in seconds for polling shared calendar data in real-time (frontend polling)
CALENDAR_POLLING_INTERVAL_SECONDS=300
# Legacy workaround: treat raw Graph calendar dateTime values labelled UTC as
# IST wall-clock mislabeled as UTC. Disproven for this mailbox, so keep false
# (raw values are parsed as true UTC). Only flip true if the mailbox regresses.
CALENDAR_SOURCE_IS_MISLABELED_UTC=false

# ---- Observability (Langfuse) ----
# When false, the app runs fully disconnected from Langfuse.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
LANGFUSE_HOST="https://cloud.langfuse.com"

# ---- Logging ----
LOG_LEVEL="INFO"
LOG_DIR="logs"
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5

# ---- OneDrive / SharePoint document sync ----
# Master switch. When true, the backend pulls PDFs from a SharePoint/OneDrive
# shared folder and ingests them into the document bot's SQLite library on
# a daily schedule. Uses the sharing URL approach (Sites.Selected permission),
# NOT Files.Read.All.
ONEDRIVE_SYNC_ENABLED=false
# SharePoint/OneDrive sharing URL — the browser URL you get when someone
# shares a folder via OneDrive or Teams. Paste the full URL here.
# Example: https://rblbank-my.sharepoint.com/shared?id=%2Fpersonal%2F...
SHAREPOINT_SITE=""
# Comma-separated file extensions to sync (only matching files are downloaded).
ONEDRIVE_FILE_EXTENSIONS=".pdf,.pptx"
# Daily sync schedule (IST). The sync runs once at this time every day.
ONEDRIVE_SYNC_SCHEDULE_HOUR=2
ONEDRIVE_SYNC_SCHEDULE_MINUTE=0
# Temp directory for downloads before ingestion (relative to backend/).
ONEDRIVE_TEMP_DIR="data/onedrive_downloads"
# Use the vision model during PDF ingestion (chart reading). false = faster.
ONEDRIVE_USE_VISION=true
# Local folder scanned instead of SharePoint when GRAPH_AUTH_MODE=local.
# Drop PDFs here for offline development without Azure credentials.
ONEDRIVE_LOCAL_DIR="data/local_onedrive"


# ---- Chatbot (RAG over raw email conversations) ----
# PostgreSQL table holding one row per raw email message. This is the
# chatbot's retrieval source, and the email pipeline upserts into it after
# every run (keyed on the Graph message id, so re-runs refresh rows rather
# than duplicating them). Created automatically at startup.
CHATBOT_PG_TABLE="bu_emails"
# Retrieval backend. true = hybrid vector + BM25 search via the shared
# Weaviate deployment; false = local on-disk FAISS index.
CHATBOT_USE_WEAVIATE=false
# Dedicated Weaviate collection for chatbot message vectors. Kept separate
# from the email cluster pipeline's collections so the two never collide.
CHATBOT_WEAVIATE_COLLECTION="ChatbotEmailMessage"
# When true, the email pipeline re-embeds the chatbot's source rows at the
# end of every run so new mail is answerable without a restart. Startup
# ingestion only runs when the collection is empty, so turning this off
# means you must reindex manually via POST /chatbot/index. No effect
# unless CHATBOT_USE_WEAVIATE is also true.
CHATBOT_AUTO_REINDEX=true

# ---- Documents bot (ex-SQLite library.db) ----
# Row data lives in PostgreSQL (uses POSTGRES_DSN above); block + series
# embedding vectors live in Weaviate. Collection names resolve to
# <prefix>Blocks and <prefix>Series on the shared Weaviate instance.
WEAVIATE_DOC_COLLECTION_PREFIX="DocLibrary"

# ---- Vector backend toggle (documents bot + chatbot only) ----
# "weaviate" (default): vectors stored in the shared Weaviate deployment.
# "faiss": vectors stored in local FAISS index files under FAISS_INDEX_DIR.
# NOTE: the email pipeline always uses Weaviate regardless of this setting.
# Switching does NOT migrate vectors — re-ingest or rebuild after switching.
CHATBOT_VECTOR_DB="weaviate"
FAISS_INDEX_DIR="data/faiss_indexes"
# Retrieval tuning: message-level candidates considered before thread grouping,
# and the number of top threads sent to the LLM.
CHATBOT_RETRIEVAL_CANDIDATES=25
CHATBOT_TOP_K=3
# Chatbot answer-generation model and generation caps.
CHATBOT_LLM_MODEL="llama3b-fast:latest"
CHATBOT_MAX_TOKENS=256
CHATBOT_LLM_NUM_CTX=4096
